ninja_required_version = 1.10

builddir = out

rule synth_frag
  command = mkdir -p $builddir && printf '#version 300 es\nprecision highp float;\n\nuniform sampler2D uTex;\nuniform vec2 uTexSize;\nuniform vec2 uOutSize;\n\nin vec2 vUV;\nout vec4 fragColor;\n\n' > $builddir/plushie.frag && cat common.glsl size.glsl analyze.glsl kernels.glsl >> $builddir/plushie.frag && sed -n '/vec3 sampleWeights/,$$p' main.frag >> $builddir/plushie.frag && grep -v '#include' $builddir/plushie.frag > $builddir/plushie.frag.tmp && mv $builddir/plushie.frag.tmp $builddir/plushie.frag && echo "synth frag ok"
  description = build frag

rule synth_vert
  command = mkdir -p $builddir && cp main.vert $builddir/plushie.vert && echo "synth vert ok"
  description = build vert

rule clean
  command = rm -rf $builddir
  description = clean

rule deps
  command = mkdir -p $builddir && missing=""; command -v sed >/dev/null || missing="$$missing sed"; command -v grep >/dev/null || missing="$$missing grep"; if [ -n "$$missing" ]; then echo "host missing:$$missing" | tee -a $builddir/build.log; exit 1; else echo "deps ok" | tee -a $builddir/build.log;
  description = deps

build $builddir/plushie.frag: synth_frag
build $builddir/plushie.vert: synth_vert

build clean: clean
build deps: deps

default $builddir/plushie.frag $builddir/plushie.vert
